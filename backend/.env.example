# Judge0 on RapidAPI
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here

# Path to your GCP service account JSON
GOOGLE_CREDENTIALS_PATH=credentials.json

# Optional: name of the root Google Drive folder for submissions
DRIVE_FOLDER_NAME=Submissions

# Secret key for Flask sessions (change this!)
FLASK_SECRET_KEY=change_this_to_a_random_string

# Admin password for the admin panel
ADMIN_PASSWORD=admin123

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers → Python
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# Google OAuth Client ID (for Google Sign-In on frontend)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
